<Window
    x:Class="ModulusDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Modulus">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Custom title bar so the window chrome is dark (#131316, the panel
             background) instead of the default white. A WebView2 can't host a
             drag region, so this thin strip above it carries the caption. -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Background="#131316">
            <TextBlock Text="Modulus" VerticalAlignment="Center"
                       Margin="14,0,0,0" FontSize="12" Foreground="#9A9AA3" />
        </Border>
        <WebView2 x:Name="Web" Grid.Row="1" />
    </Grid>
</Window>
