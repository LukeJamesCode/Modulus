{
  // Typechecks the first-party bundled modules against the real core types
  // (src/**), the same way the module loader runs them at runtime. Separate from
  // the root tsconfig because modules live outside src/ (rootDir there is src/).
  // Mirrors the root's strictness so a module that typechecks here behaves the
  // same once installed. Run via `npm run typecheck:modules`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  // Test files are run (and transpiled) by the test runner, not typechecked
  // here — they use array indexing freely, which noUncheckedIndexedAccess
  // flags. This pass guards the shipping module code against the core types.
  "include": ["**/*.ts", "../src/**/*.ts"],
  // Heavy modules import third-party packages (playwright, discord.js) that core
  // deliberately does NOT carry — they ship with the opt-in module and are
  // installed only when a user enables it. Their tool entrypoints can't resolve
  // here, so they're excluded from the core typecheck; the pure, safety-critical
  // logic each ships (e.g. the SSRF guard) lives in its own file and IS checked.
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "modulus-browser/tools.ts",
    "modulus-discord/jobs.ts",
    "modulus-discord/lib/client.ts",
    "modulus-discord/lib/voice.ts"
  ]
}
