{
  "name": "modulus-agent",
  "version": "1.7.0",
  "description": "The everyday AI orchestrator. CPU-only core, integrated UI, modules turn it into anything.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "ai",
    "agent",
    "assistant",
    "llm",
    "ollama",
    "telegram",
    "orchestrator",
    "mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "modulus": "./dist/cli/index.js",
    "modulus-agent": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "modules",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!**/*.test.ts",
    "!**/*.test.js",
    "!**/*.map",
    "!**/tsconfig.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs && node scripts/copy-web.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:modules": "tsc -p modules/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs",
    "bench:spec-decode": "node scripts/bench-spec-decode.mjs",
    "pack-smoke": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.10",
    "@types/ws": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "better-sqlite3": "12.9.0",
    "commander": "^14.0.3",
    "grammy": "^1.42.0",
    "tsx": "^4.19.2",
    "unpdf": "^1.6.2",
    "ws": "^8.21.0"
  }
}
